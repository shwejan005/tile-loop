# Local Supabase defaults. Copy to .env.local after `npm run supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used for email confirmation and password-reset redirects.
APP_URL=http://127.0.0.1:3000

# Server-only Supabase secret key. Used only for authenticated account deletion.
# Never prefix this with NEXT_PUBLIC_ or expose it in a browser bundle.
SUPABASE_SECRET_KEY=
